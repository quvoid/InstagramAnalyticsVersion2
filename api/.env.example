# Copy this file to .env and fill in real values. .env is gitignored -- never commit it.

# Secret your website must send in the X-API-Key header. Generate a real one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=changeme-generate-a-real-secret

# Folder containing scrape_profiles.py (which holds your live IG session COOKIES).
# Defaults to the InstagramAnalytics project root if left unset.
PROJECT_DIR=C:\Users\omkar\OneDrive\Desktop\InstagramAnalytics

# Comma-separated list of origins allowed to call this API from a browser
# (your website's domain). "*" allows any origin -- fine for local testing,
# tighten this before anything public depends on it.
ALLOWED_ORIGINS=*

# Seconds a brand's live result is reused if a second request for the same
# brand arrives while a scan is still fresh. This does NOT make responses
# stale beyond this window -- it only stops overlapping requests from
# double-hitting Instagram at once. Set to 0 to disable and always re-scrape.
SCAN_COOLDOWN_SECONDS=60

# Default number of posts scanned per brand if the caller doesn't specify one.
DEFAULT_MAX_POSTS=400

# Max usernames allowed in a single POST /api/v1/profile/bulk request.
BULK_MAX_USERNAMES=2000

# Random delay range (seconds) between accounts in a bulk profile job, to
# stay within Instagram's rate limits -- same idea as every other scraper
# in this project. Lower = faster but more likely to trip rate limiting.
BULK_DELAY_MIN=0.8
BULK_DELAY_MAX=1.8
