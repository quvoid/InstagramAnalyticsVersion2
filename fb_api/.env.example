# Copy this file to .env and fill in real values. .env is gitignored -- never commit it.

# Secret your website must send in the X-API-Key header. Generate a real one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=changeme-generate-a-real-secret

# Comma-separated origins allowed to call this API from a browser. "*" is fine
# for local testing; tighten it before anything public depends on this.
ALLOWED_ORIGINS=*

# Seconds a query's result is reused if the same query arrives again while the
# first is still fresh. Not a data cache -- it only stops accidental
# double-calls from firing two live scans. 0 disables it.
SCAN_COOLDOWN_SECONDS=60

# --- YOUR FACEBOOK SESSION GOES HERE ----------------------------------------
# Same idea as the Instagram cookies in scrape_profiles.py, just kept out of
# the code. Two ways to supply it -- use whichever you prefer, the file wins
# if you set both.
#
# How to get it:
#   1. Open facebook.com in a browser where you're logged in.
#   2. DevTools (F12) -> Network tab -> reload -> click any facebook.com request.
#   3. Request Headers -> right-click the `cookie:` line -> Copy value.
#   4. Paste the WHOLE thing (it's long, and it must include c_user and xs --
#      a couple of cookies won't do). A leading "cookie:" label is fine.
#
# Option A: paste it here, on one line.
FB_COOKIE=
#
# Option B: put it in a file and point at the file. Easier to live with,
# because the header is ~1-2KB. The file can be the raw cookie header, a
# cookie-editor JSON export, or a Netscape cookies.txt.
# FB_COOKIE_FILE=C:\Users\omkar\OneDrive\Desktop\InstagramAnalytics\fb_api\fb_cookie.txt
#
# Verify it before running anything real:
#   curl -H "X-API-Key: <key>" http://localhost:8001/api/v1/session/check

# --- Ad Library -------------------------------------------------------------
# How the Ad Library endpoints talk to Meta:
#   graphql  DEFAULT. Cookies only, no browser. Queries Meta's GraphQL endpoint
#            directly and never touches the /ads/library/ HTML route, which is
#            the route that serves the anti-bot challenge.
#   http     the /ads/library/ HTML route with the same cookies. Its payload
#            carries Meta's own total ad count, which graphql doesn't expose --
#            but Meta challenges this route even for logged-in sessions, so it
#            usually just 503s. Kept in case that ever changes.
#   browser  headless Chromium via Playwright. Needs no cookies at all, and can
#            rediscover the GraphQL doc_id when Meta rotates it. Requires
#            `pip install playwright && python -m playwright install chromium`.
# Override per request with ?transport=...
AD_TRANSPORT=graphql

# Both of these only matter when AD_TRANSPORT=browser.
HEADLESS=true
MAX_CONCURRENT_AD_SCANS=1

# Optional. Meta rotates the persisted-query id for the Ad Library search
# whenever it ships that JS bundle. If scans start failing with "Meta most
# likely rotated the doc_id", open the Ad Library in a browser, search the JS
# bundles for AdLibrarySearchPaginationQuery_facebookRelayOperation, and paste
# the number here. (One scan with ?transport=browser also finds it for you.)
AD_DOC_ID=

# Default country for Ad Library searches (ISO 2-letter).
DEFAULT_COUNTRY=IN

# Default cap on ads pulled per scan. Meta reports the true total either way,
# so a truncated scan is always visible in the response.
DEFAULT_MAX_ADS=2000

# --- bulk jobs --------------------------------------------------------------
BULK_MAX_ITEMS=500
BULK_DELAY_MIN=0.8
BULK_DELAY_MAX=1.8

# --- official Graph API (optional) ------------------------------------------
# Only needed for /api/v1/official/*. Requires a Meta developer app and
# identity confirmation at facebook.com/ID. Note that outside the EU/UK the
# official ad archive only carries political and social-issue ads.
FB_GRAPH_TOKEN=
GRAPH_API_VERSION=v23.0
